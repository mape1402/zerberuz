<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Zerberuz</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #04070d;
            --surface: #08111c;
            --panel: #0d1724;
            --panel-2: #101c2a;
            --ink: #f8fbff;
            --muted: #8fa3b7;
            --muted-2: #64788b;
            --line: #1f3347;
            --cyan: #08c8f6;
            --cyan-soft: rgba(8, 200, 246, .1);
            --amber: #ff9f0a;
            --amber-soft: rgba(255, 159, 10, .11);
            --danger: #ff6b4a;
            --ok: #38d6a8;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--bg);
            color: var(--ink);
            font: 15px/1.5 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid var(--line);
            background: #050a12;
        }

        nav, main {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px;
        }

        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        nav a, a {
            color: var(--cyan);
            text-decoration: none;
        }

        nav a {
            color: var(--muted);
            font-weight: 650;
        }

        nav a:hover {
            color: var(--cyan);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--ink);
            font-size: 19px;
            font-weight: 800;
        }

        .brand-mark {
            display: grid;
            width: 38px;
            height: 38px;
            place-items: center;
            border: 1px solid rgba(8, 200, 246, .55);
            border-radius: 8px;
            background: #071522;
            color: var(--cyan);
            font-weight: 950;
        }

        .nav-links {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link {
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 8px 10px;
        }

        .nav-link:hover {
            border-color: rgba(8, 200, 246, .25);
            background: var(--cyan-soft);
        }

        h1 {
            margin: 0;
            font-size: 34px;
            line-height: 1.15;
            letter-spacing: 0;
        }

        h2 {
            margin: 28px 0 12px;
            font-size: 18px;
        }

        .page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin: 18px 0 24px;
        }

        .eyebrow {
            color: var(--amber);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .08em;
            margin: 0 0 6px;
            text-transform: uppercase;
        }

        .lead {
            color: var(--muted);
            margin: 8px 0 0;
            max-width: 720px;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 16px 0 22px;
        }

        .button {
            border: 1px solid rgba(8, 200, 246, .7);
            border-radius: 8px;
            background: var(--cyan);
            color: #001019;
            cursor: pointer;
            display: inline-block;
            font-weight: 750;
            padding: 10px 14px;
            text-decoration: none;
        }

        .button.secondary {
            background: rgba(8, 200, 246, .08);
            color: var(--cyan);
        }

        .button.warn {
            border-color: rgba(255, 159, 10, .76);
            background: var(--amber);
            color: #190d00;
        }

        .button.danger {
            border-color: rgba(255, 107, 74, .7);
            background: rgba(255, 107, 74, .1);
            color: var(--danger);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin: 0 0 18px;
        }

        .stat, .panel, .aside, .workflow-card, .rule-card {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
        }

        .stat {
            padding: 16px;
        }

        .stat strong {
            display: block;
            font-size: 28px;
            line-height: 1;
        }

        .stat span {
            color: var(--muted);
            display: block;
            margin-top: 8px;
        }

        .panel {
            overflow: hidden;
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            border-bottom: 1px solid var(--line);
            padding: 16px;
        }

        .panel-header strong {
            font-size: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: transparent;
        }

        th, td {
            border-bottom: 1px solid var(--line);
            padding: 13px 16px;
            text-align: left;
            vertical-align: top;
        }

        th {
            color: var(--muted);
            font-size: 13px;
            font-weight: 750;
            text-transform: uppercase;
        }

        tr:last-child td {
            border-bottom: 0;
        }

        .version-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .pill {
            border: 1px solid rgba(8, 200, 246, .34);
            border-radius: 999px;
            background: var(--cyan-soft);
            color: var(--cyan);
            display: inline-flex;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 9px;
            text-decoration: none;
        }

        .pill.amber {
            border-color: rgba(255, 159, 10, .36);
            background: var(--amber-soft);
            color: var(--amber);
        }

        code, pre, textarea, input {
            font: 13px/1.45 "Cascadia Mono", Consolas, monospace;
        }

        pre, textarea, input {
            box-sizing: border-box;
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface);
            color: var(--ink);
            padding: 12px;
        }

        textarea:focus, input:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(8, 200, 246, .12);
            outline: 0;
        }

        textarea {
            min-height: 420px;
            resize: vertical;
        }

        .rule-card textarea {
            min-height: 110px;
        }

        .form-shell {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            gap: 18px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            padding: 16px;
        }

        .form-grid.two {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .wizard {
            display: grid;
            grid-template-columns: 260px minmax(0, 1fr);
            gap: 18px;
        }

        .stepper {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
            list-style: none;
            margin: 0;
            padding: 8px;
        }

        .stepper li {
            border-radius: 8px;
            color: var(--muted);
            padding: 12px;
        }

        .stepper li.active {
            background: var(--cyan-soft);
            color: var(--ink);
        }

        .stepper strong {
            display: block;
        }

        .stepper span {
            display: block;
            font-size: 13px;
            margin-top: 3px;
        }

        .wizard-step {
            display: none;
        }

        .wizard-step.active {
            display: block;
        }

        .step-copy {
            color: var(--muted);
            margin: 0;
            padding: 0 16px 16px;
        }

        .review-list {
            display: grid;
            gap: 10px;
            padding: 16px;
        }

        .hidden-store {
            display: none;
        }

        .modal-backdrop {
            align-items: center;
            background: rgba(0, 0, 0, .62);
            display: none;
            inset: 0;
            justify-content: center;
            padding: 22px;
            position: fixed;
            z-index: 30;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
            max-height: min(88vh, 920px);
            max-width: 980px;
            overflow: auto;
            width: 100%;
        }

        .modal-body {
            padding: 0;
        }

        .modal-footer {
            border-top: 1px solid var(--line);
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            padding: 16px;
        }

        .markdown-preview {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface);
            box-sizing: border-box;
            min-height: 180px;
            padding: 14px;
        }

        .markdown-preview h1,
        .markdown-preview h2,
        .markdown-preview h3 {
            margin: 0 0 10px;
        }

        .markdown-preview p,
        .markdown-preview ul,
        .markdown-preview pre {
            margin: 0 0 12px;
        }

        .markdown-preview pre {
            border: 1px solid var(--line);
            border-radius: 8px;
            overflow: auto;
        }

        label {
            color: var(--muted);
            display: block;
            font-size: 12px;
            font-weight: 750;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        select {
            box-sizing: border-box;
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface);
            color: var(--ink);
            padding: 11px 12px;
        }

        details {
            border-top: 1px solid var(--line);
            padding: 16px;
        }

        summary {
            color: var(--cyan);
            cursor: pointer;
            font-weight: 750;
        }

        .aside {
            padding: 16px;
        }

        .aside ul {
            margin: 10px 0 0;
            padding-left: 18px;
        }

        .workflow {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin: 0 0 18px;
        }

        .workflow-card {
            border-left: 3px solid var(--cyan);
            padding: 14px;
        }

        .workflow-card strong {
            display: block;
        }

        .workflow-card span {
            color: var(--muted);
            display: block;
            margin-top: 5px;
        }

        .aside .workflow-card {
            background: var(--surface);
            margin-bottom: 12px;
        }

        .profile-name {
            color: var(--ink);
            font-size: 18px;
            font-weight: 800;
        }

        .row-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .rule-grid {
            display: grid;
            gap: 12px;
            margin-top: 18px;
        }

        .rule-card {
            padding: 16px;
        }

        .rule-card + .rule-card {
            margin-top: 12px;
        }

        .rule-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
        }

        .rule-title {
            margin: 8px 0 0;
            font-size: 17px;
            font-weight: 800;
        }

        .rule-meta {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-top: 14px;
        }

        .meta-box {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface);
            padding: 10px;
        }

        .meta-box span {
            color: var(--muted-2);
            display: block;
            font-size: 12px;
            font-weight: 750;
            text-transform: uppercase;
        }

        .meta-box strong, .meta-box code {
            display: block;
            margin-top: 4px;
        }

        .json-template {
            min-height: 560px;
        }

        .message {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
            margin: 14px 0;
            padding: 12px;
        }

        .message.ok {
            border-color: var(--ok);
            color: var(--ok);
        }

        .message.error {
            border-color: var(--danger);
            color: var(--danger);
        }

        .muted {
            color: var(--muted);
        }

        .empty {
            border: 1px dashed rgba(8, 200, 246, .35);
            border-radius: 8px;
            background: rgba(8, 200, 246, .06);
            padding: 22px;
        }

        @@media (max-width: 760px) {
            .page-heading, nav {
                align-items: flex-start;
                flex-direction: column;
            }

            .stats, .form-shell, .workflow, .rule-meta, .form-grid, .form-grid.two, .wizard {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <a class="brand" href="/zerberuz"><span class="brand-mark">Z</span><span>Zerberuz Admin</span></a>
            <span class="nav-links">
                <a class="nav-link" href="/zerberuz">Profiles</a>
                <a class="nav-link" href="/zerberuz/publish">New Version</a>
            </span>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>

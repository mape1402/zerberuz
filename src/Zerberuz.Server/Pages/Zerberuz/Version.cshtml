@page "/zerberuz/profiles/{profile}/versions/{version}"
@model VersionModel
@{
    ViewData["Title"] = "Rule Profile";
}

@if (Model.RuleSet is null)
{
    <h1>Rule profile not found</h1>
    <p class="muted">The requested profile version does not exist.</p>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Profile Version</p>
            <h1>@Model.RuleSet.Profile</h1>
            <p class="lead">This version contains the rules downloaded by analyzers for this profile. Publish a new version to change rules.</p>
        </div>
        <div class="toolbar">
            <a class="button secondary" href="/zerberuz">Back</a>
            <a class="button" href="/api/v1/profiles/@Uri.EscapeDataString(Model.RuleSet.Profile)/versions/@Uri.EscapeDataString(Model.RuleSet.RulesVersion)">API JSON</a>
        </div>
    </div>

    <section class="stats">
        <div class="stat">
            <strong>@Model.RuleSet.Rules.Count</strong>
            <span>Rules</span>
        </div>
        <div class="stat">
            <strong>@Model.RuleSet.Help.Count</strong>
            <span>Help topics</span>
        </div>
        <div class="stat">
            <strong>@Model.RuleSet.RulesVersion</strong>
            <span>Version</span>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <strong>Technical Summary</strong>
            <span class="muted">Minimum engine: @Model.RuleSet.MinimumEngineVersion</span>
        </div>
        <table>
            <tbody>
                <tr>
                    <th>Schema</th>
                    <td>@Model.RuleSet.SchemaVersion</td>
                </tr>
                <tr>
                    <th>Profile</th>
                    <td>@Model.RuleSet.Profile</td>
                </tr>
                <tr>
                    <th>Rules version</th>
                    <td>@Model.RuleSet.RulesVersion</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="rule-grid">
        @foreach (var rule in Model.RuleSet.Rules)
        {
            <article class="rule-card">
                <div class="rule-header">
                    <div>
                        <span class="pill">@rule.Id</span>
                        <div class="rule-title">@rule.Title</div>
                    </div>
                    <span class="pill amber">@rule.Severity</span>
                </div>

                <div class="rule-meta">
                    <div class="meta-box">
                        <span>Type</span>
                        <strong>@rule.Type</strong>
                    </div>
                    <div class="meta-box">
                        <span>Target</span>
                        <code>@Model.GetTargetSummary(rule)</code>
                    </div>
                    <div class="meta-box">
                        <span>Condition</span>
                        <code>@Model.GetConditionSummary(rule)</code>
                    </div>
                </div>

                <div class="rule-meta">
                    <div class="meta-box">
                        <span>Message</span>
                        <strong>@rule.Message</strong>
                    </div>
                    <div class="meta-box">
                        <span>Help</span>
                        <strong>@Model.GetHelpTitle(rule.Id)</strong>
                    </div>
                    <div class="meta-box">
                        <span>Help URL</span>
                        @if (string.IsNullOrWhiteSpace(rule.HelpUrl))
                        {
                            <strong>Server help endpoint</strong>
                        }
                        else
                        {
                            <a href="@rule.HelpUrl">@rule.HelpUrl</a>
                        }
                    </div>
                </div>
            </article>
        }
    </section>
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zerberuz</ToolCommandName>
    <PackageId>Zerberuz.Cli</PackageId>
    <Title>Zerberuz.Cli</Title>
    <Description>Command-line tooling for Zerberuz rule sync, cache validation, and diagnostic explanations.</Description>
    <PackageTags>roslyn;analyzers;cli;diagnostics;dotnet-tool;zerberuz</PackageTags>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <ProjectReference Include="..\Zerberuz.Analyzers.Configuration\Zerberuz.Analyzers.Configuration.csproj" />
    <ProjectReference Include="..\Zerberuz.Analyzers.Rules\Zerberuz.Analyzers.Rules.csproj" />
    <ProjectReference Include="..\Zerberuz.Server.Contracts\Zerberuz.Server.Contracts.csproj" />
  </ItemGroup>
</Project>

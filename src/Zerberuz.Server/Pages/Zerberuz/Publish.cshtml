@page "/zerberuz/publish"
@model PublishModel
@{
    ViewData["Title"] = "Publish";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Publicacion</p>
        <h1>Crear perfil o nueva version</h1>
        <p class="lead">Zerberuz publica reglas por version. Si el <code>profile</code> no existe se crea; si ya existe, se agrega una nueva <code>rulesVersion</code>.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="message @(Model.Succeeded ? "ok" : "error")">@Model.Message</div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="form-shell">
        <aside class="aside">
            <div class="workflow-card">
                <strong>Perfil</strong>
                <span><code>profile</code> separa configuraciones por equipo, app o capa.</span>
            </div>
            <div class="workflow-card">
                <strong>Version</strong>
                <span><code>rulesVersion</code> no se edita: publica una nueva cuando cambien reglas.</span>
            </div>
            <div class="workflow-card">
                <strong>Reglas</strong>
                <span><code>rules</code> define cada diagnostico; <code>help</code> debe tener el mismo id.</span>
            </div>
            <div class="toolbar">
                <button class="button warn" type="submit">Publicar</button>
                <a class="button secondary" href="/zerberuz">Cancelar</a>
            </div>
        </aside>
        <section class="panel">
            <div class="panel-header">
                <strong>Ruleset JSON</strong>
                <span class="muted">profile + rulesVersion deben ser unicos</span>
            </div>
            <textarea class="json-template" id="RuleSetJson" name="RuleSetJson" spellcheck="false">@Model.RuleSetJson</textarea>
        </section>
    </div>
</form>

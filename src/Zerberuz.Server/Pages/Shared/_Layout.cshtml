<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Zerberuz</title>
    <style>
        :root {
            color-scheme: light;
            --bg: #f7f7f4;
            --ink: #171717;
            --muted: #66645f;
            --line: #d8d6ce;
            --panel: #ffffff;
            --accent: #005f73;
            --danger: #a43e2b;
            --ok: #397367;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font: 15px/1.5 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        header {
            border-bottom: 1px solid var(--line);
            background: var(--panel);
        }

        nav, main {
            max-width: 1120px;
            margin: 0 auto;
            padding: 20px;
        }

        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        nav a {
            color: var(--accent);
            font-weight: 650;
            text-decoration: none;
        }

        .brand {
            color: var(--ink);
            font-size: 19px;
            font-weight: 800;
        }

        h1 {
            margin: 8px 0 16px;
            font-size: 30px;
            line-height: 1.15;
        }

        h2 {
            margin: 28px 0 12px;
            font-size: 18px;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 16px 0 22px;
        }

        .button {
            border: 1px solid var(--accent);
            border-radius: 6px;
            background: var(--accent);
            color: #fff;
            cursor: pointer;
            display: inline-block;
            font-weight: 650;
            padding: 8px 12px;
            text-decoration: none;
        }

        .button.secondary {
            background: transparent;
            color: var(--accent);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--panel);
            border: 1px solid var(--line);
        }

        th, td {
            border-bottom: 1px solid var(--line);
            padding: 10px 12px;
            text-align: left;
            vertical-align: top;
        }

        th {
            color: var(--muted);
            font-size: 13px;
            font-weight: 750;
            text-transform: uppercase;
        }

        code, pre, textarea, input {
            font: 13px/1.45 "Cascadia Mono", Consolas, monospace;
        }

        pre, textarea, input {
            box-sizing: border-box;
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--panel);
            color: var(--ink);
            padding: 12px;
        }

        textarea {
            min-height: 420px;
            resize: vertical;
        }

        .message {
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--panel);
            margin: 14px 0;
            padding: 12px;
        }

        .message.ok {
            border-color: var(--ok);
            color: var(--ok);
        }

        .message.error {
            border-color: var(--danger);
            color: var(--danger);
        }

        .muted {
            color: var(--muted);
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <a class="brand" href="/zerberuz">Zerberuz Admin</a>
            <span>
                <a href="/zerberuz">Profiles</a>
                &nbsp; · &nbsp;
                <a href="/zerberuz/publish">Publish</a>
            </span>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>

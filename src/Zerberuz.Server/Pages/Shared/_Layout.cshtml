<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Zerberuz</title>
    <style>
        :root {
            color-scheme: dark;
            --bg: #04070d;
            --panel: #0d1724;
            --ink: #f8fbff;
            --muted: #8fa3b7;
            --line: #1f3347;
            --cyan: #08c8f6;
            --cyan-soft: rgba(8, 200, 246, .15);
            --amber: #ff9f0a;
            --amber-soft: rgba(255, 159, 10, .16);
            --danger: #ff6b4a;
            --ok: #38d6a8;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 18% 8%, rgba(8, 200, 246, .14), transparent 32%),
                radial-gradient(circle at 85% 18%, rgba(255, 159, 10, .12), transparent 28%),
                linear-gradient(145deg, var(--bg), #07101a 58%, #030509);
            color: var(--ink);
            font: 15px/1.5 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        header {
            position: sticky;
            top: 0;
            z-index: 10;
            border-bottom: 1px solid rgba(8, 200, 246, .22);
            background: rgba(4, 7, 13, .82);
            backdrop-filter: blur(18px);
        }

        nav, main {
            max-width: 1180px;
            margin: 0 auto;
            padding: 18px 22px;
        }

        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        nav a, a {
            color: var(--cyan);
            text-decoration: none;
        }

        nav a {
            color: var(--muted);
            font-weight: 650;
        }

        nav a:hover {
            color: var(--cyan);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--ink);
            font-size: 19px;
            font-weight: 800;
        }

        .brand-mark {
            display: grid;
            width: 38px;
            height: 38px;
            place-items: center;
            border: 1px solid rgba(8, 200, 246, .55);
            border-radius: 8px;
            background: linear-gradient(145deg, rgba(8, 200, 246, .2), rgba(255, 159, 10, .14));
            box-shadow: 0 0 28px rgba(8, 200, 246, .2);
            color: var(--cyan);
            font-weight: 950;
        }

        .nav-links {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link {
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 8px 10px;
        }

        .nav-link:hover {
            border-color: rgba(8, 200, 246, .25);
            background: rgba(8, 200, 246, .08);
        }

        h1 {
            margin: 0;
            font-size: 34px;
            line-height: 1.15;
            letter-spacing: 0;
        }

        h2 {
            margin: 28px 0 12px;
            font-size: 18px;
        }

        .page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin: 18px 0 24px;
        }

        .eyebrow {
            color: var(--amber);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .08em;
            margin: 0 0 6px;
            text-transform: uppercase;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 16px 0 22px;
        }

        .button {
            border: 1px solid rgba(8, 200, 246, .7);
            border-radius: 8px;
            background: linear-gradient(135deg, #08c8f6, #0d8de3);
            box-shadow: 0 10px 28px rgba(8, 200, 246, .2);
            color: #001019;
            cursor: pointer;
            display: inline-block;
            font-weight: 750;
            padding: 10px 14px;
            text-decoration: none;
        }

        .button.secondary {
            background: rgba(8, 200, 246, .08);
            box-shadow: none;
            color: var(--cyan);
        }

        .button.warn {
            border-color: rgba(255, 159, 10, .76);
            background: linear-gradient(135deg, #ffb52e, #ff8a00);
            box-shadow: 0 10px 28px rgba(255, 159, 10, .18);
            color: #190d00;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin: 0 0 18px;
        }

        .stat, .panel, .aside {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: linear-gradient(180deg, rgba(16, 31, 46, .94), rgba(8, 14, 24, .94));
            box-shadow: 0 18px 60px rgba(0, 0, 0, .26);
        }

        .stat {
            padding: 16px;
        }

        .stat strong {
            display: block;
            font-size: 28px;
            line-height: 1;
        }

        .stat span {
            color: var(--muted);
            display: block;
            margin-top: 8px;
        }

        .panel {
            overflow: hidden;
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            border-bottom: 1px solid var(--line);
            padding: 16px;
        }

        .panel-header strong {
            font-size: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: transparent;
        }

        th, td {
            border-bottom: 1px solid var(--line);
            padding: 13px 16px;
            text-align: left;
            vertical-align: top;
        }

        th {
            color: var(--muted);
            font-size: 13px;
            font-weight: 750;
            text-transform: uppercase;
        }

        tr:last-child td {
            border-bottom: 0;
        }

        .version-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .pill {
            border: 1px solid rgba(8, 200, 246, .34);
            border-radius: 999px;
            background: var(--cyan-soft);
            color: var(--cyan);
            display: inline-flex;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 9px;
            text-decoration: none;
        }

        .pill.amber {
            border-color: rgba(255, 159, 10, .36);
            background: var(--amber-soft);
            color: var(--amber);
        }

        code, pre, textarea, input {
            font: 13px/1.45 "Cascadia Mono", Consolas, monospace;
        }

        pre, textarea, input {
            box-sizing: border-box;
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: #08111c;
            color: var(--ink);
            padding: 12px;
        }

        textarea:focus, input:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(8, 200, 246, .12);
            outline: 0;
        }

        textarea {
            min-height: 420px;
            resize: vertical;
        }

        .form-shell {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 18px;
        }

        .aside {
            padding: 16px;
        }

        .aside ul {
            margin: 10px 0 0;
            padding-left: 18px;
        }

        .message {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--panel);
            margin: 14px 0;
            padding: 12px;
        }

        .message.ok {
            border-color: var(--ok);
            color: var(--ok);
        }

        .message.error {
            border-color: var(--danger);
            color: var(--danger);
        }

        .muted {
            color: var(--muted);
        }

        .empty {
            border: 1px dashed rgba(8, 200, 246, .35);
            border-radius: 8px;
            background: rgba(8, 200, 246, .06);
            padding: 22px;
        }

        @@media (max-width: 760px) {
            .page-heading, nav {
                align-items: flex-start;
                flex-direction: column;
            }

            .stats, .form-shell {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <a class="brand" href="/zerberuz"><span class="brand-mark">Z</span><span>Zerberuz Admin</span></a>
            <span class="nav-links">
                <a class="nav-link" href="/zerberuz">Profiles</a>
                <a class="nav-link" href="/zerberuz/publish">Publish</a>
            </span>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>

@page "/zerberuz"
@model IndexModel
@{
    ViewData["Title"] = "Profiles";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Zerberuz Server</p>
        <h1>Rule Profiles</h1>
        <p class="lead">A profile groups analyzer rules for a context such as backend, frontend, or contracts. Every change is published as an immutable version.</p>
    </div>
    <a class="button warn" href="/zerberuz/publish">Create Profile Version</a>
</div>

<section class="workflow">
    <div class="workflow-card">
        <strong>1. Name the profile</strong>
        <span>The profile name creates a new profile when it does not exist.</span>
    </div>
    <div class="workflow-card">
        <strong>2. Configure rules</strong>
        <span>Each rule has a diagnostic id, target, condition, message, and help content.</span>
    </div>
    <div class="workflow-card">
        <strong>3. Publish a version</strong>
        <span>The rules version must be new; older versions remain available.</span>
    </div>
</section>

<section class="stats">
    <div class="stat">
        <strong>@Model.ProfileCount</strong>
        <span>Profiles</span>
    </div>
    <div class="stat">
        <strong>@Model.VersionCount</strong>
        <span>Published versions</span>
    </div>
    <div class="stat">
        <strong>@Model.LatestVersionCount</strong>
        <span>Active profiles</span>
    </div>
</section>

@if (Model.Profiles.Count == 0)
{
    <div class="empty">
        <strong>No profiles yet.</strong>
        <p class="muted">Create the first one by publishing a guided profile version.</p>
        <div class="toolbar">
            <a class="button warn" href="/zerberuz/publish">Create First Profile</a>
        </div>
    </div>
}
else
{
    <section class="panel">
        <div class="panel-header">
            <strong>Published Profiles</strong>
            <span class="muted">Open the current version to inspect each configured rule.</span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Profile</th>
                    <th>Current version</th>
                    <th>Rules</th>
                    <th>History</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.Profiles)
                {
                    var currentVersion = profile.Versions.FirstOrDefault();
                    <tr>
                        <td>
                            <span class="profile-name">@profile.Name</span><br />
                            <span class="muted">Analyzer profile</span>
                        </td>
                        <td>
                            @if (currentVersion is null)
                            {
                                <span class="muted">No versions</span>
                            }
                            else
                            {
                                <a class="pill amber" href="/zerberuz/profiles/@Uri.EscapeDataString(profile.Name)/versions/@Uri.EscapeDataString(currentVersion)">@currentVersion</a>
                            }
                        </td>
                        <td>
                            @if (profile.CurrentRuleSet is null)
                            {
                                <span class="muted">0 rules</span>
                            }
                            else
                            {
                                <strong>@profile.CurrentRuleSet.Rules.Count</strong><br />
                                <span class="muted">@profile.CurrentRuleSet.Help.Count help topics</span>
                            }
                        </td>
                        <td>
                            <span class="version-list">
                                @foreach (var version in profile.Versions)
                                {
                                    <a class="pill" href="/zerberuz/profiles/@Uri.EscapeDataString(profile.Name)/versions/@Uri.EscapeDataString(version)">@version</a>
                                }
                            </span>
                        </td>
                        <td>
                            <span class="row-actions">
                                @if (currentVersion is not null)
                                {
                                    <a class="button secondary" href="/zerberuz/profiles/@Uri.EscapeDataString(profile.Name)/versions/@Uri.EscapeDataString(currentVersion)">View Rules</a>
                                }
                                <a class="button secondary" href="/zerberuz/publish">New Version</a>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
